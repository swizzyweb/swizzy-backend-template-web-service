{
  "name": "@swizzyweb/swizzy-backend-template-web-service",
  "version": "0.2.1",
  "description": "Template for swizzyweb backend web services",
  "main": "dist/app.js",
  "type": "module",
  "author": "Jason Gallagher",
  "scripts": {
    "dev": "npm run build && npm run server",
    "server": "swerve",
    "build:service": "tsc",
    "build": "npm run build:service",
    "test": "tsc -p tsconfig.test.json && node --test ./dist/test/**/*.spec.js"
  },
  "keywords": [
    "react",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@swizzyweb/swerve": "^0.6.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@swizzyweb/swizzy-common": "^0.3.3",
    "@swizzyweb/swizzy-web-service": "^0.6.1"
  }
}
